# Lexora - Git Ignore Configuration

# Python virtual environments & build artifacts
.venv/
venv/
env/
ENV/
bin/
lib/
include/
share/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Next.js build files and node dependencies
node_modules/
.next/
out/
.docusaurus/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and local configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
*.swp
*.swo
.DS_Store
Thumbs.db

# Storage databases and vectors (highly private / local only)
storage/documents/*
storage/faiss/*
storage/metadata/*

# Keep structural placeholder files in storage
!storage/documents/.gitkeep
!storage/faiss/.gitkeep
!storage/metadata/.gitkeep
